{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "default": {
      "()": "app.core.logging_config.LocalTimeFormatter",
      "fmt": "%(asctime)s %(levelname)-5s %(process)d %(name)s: %(message)s"
    },
    "access": {
      "()": "app.core.logging_config.LocalTimeFormatter",
      "fmt": "%(asctime)s %(levelname)-5s %(process)d %(name)s: %(message)s"
    }
  },
  "handlers": {
    "default": {
      "formatter": "default",
      "class": "logging.StreamHandler",
      "stream": "ext://sys.stderr"
    },
    "access": {
      "formatter": "access",
      "class": "logging.StreamHandler",
      "stream": "ext://sys.stdout"
    }
  },
  "loggers": {
    "uvicorn": {
      "handlers": ["default"],
      "level": "INFO",
      "propagate": false
    },
    "uvicorn.error": {
      "level": "INFO"
    },
    "uvicorn.access": {
      "handlers": ["access"],
      "level": "INFO",
      "propagate": false
    }
  }
}
